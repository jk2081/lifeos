{
  "name": "Life OS",
  "short_name": "Life OS",
  "description": "A personal operating system: capture, tasks, calendar, journal, library and vault.",
  "id": "/life",
  "start_url": "/life/today",
  "scope": "/life",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#171717",
  "icons": [
    { "src": "/assets/lifeos/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/lifeos/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/lifeos/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Brain", "url": "/life/brain" },
    { "name": "Tasks", "url": "/life/tasks" },
    { "name": "Today", "url": "/life/today" }
  ],
  "share_target": {
    "action": "/life/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "audio/*", "text/plain", "text/markdown", "text/csv"] }]
    }
  }
}
